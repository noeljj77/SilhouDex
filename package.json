{
  "name": "silhoudex",
  "private": true,
  "version": "1.0.0",
  "description": "SilhouDex — a daily Pokémon silhouette guessing game. Every shadow has a story.",
  "license": "MIT",
  "author": "Noel John Jacob",
  "homepage": "https://noeljj77.github.io/SilhouDex/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noeljj77/SilhouDex.git"
  },
  "bugs": {
    "url": "https://github.com/noeljj77/SilhouDex/issues"
  },
  "keywords": [
    "pokemon",
    "game",
    "react",
    "typescript",
    "vite",
    "tailwindcss",
    "firebase",
    "pwa"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:index": "tsx scripts/build-pokedex-index.ts"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "firebase": "^13.1.0",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
